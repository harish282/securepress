{
    "name": "securepress/securepress",
    "description": "Laravel-inspired security infrastructure for WordPress",
    "license": "GPL-2.0-or-later",
    "type": "wordpress-plugin",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "SecurePress\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SecurePress\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
