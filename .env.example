# SecurePress environment variables
# Copy to .env and update values as needed.

SECUREPRESS_APP_ENV=production
SECUREPRESS_DEBUG=false

# Default install: ~6 months Pro trial (config/plugin.php `pro_license.beta_trial`).
# Override trial: SECUREPRESS_BETA_TRIAL_ENABLED=false  SECUREPRESS_BETA_TRIAL_DURATION_DAYS=182
# Unlimited Pro without key (optional; overrides trial clock): SECUREPRESS_EARLY_ACCESS=true
# SECUREPRESS_EARLY_ACCESS=

# HMAC secret for offline Pro license keys (must match your issuance tooling).
# Never commit a real value — set in production environment only.
# SECUREPRESS_LICENSE_SECRET=
SECUREPRESS_MIN_PHP_VERSION=8.2.0
SECUREPRESS_MIN_WP_VERSION=6.4
SECUREPRESS_LOG_CHANNEL=file
SECUREPRESS_LOG_LEVEL=info
SECUREPRESS_LOG_FILE=securepress.log

# Emergency recovery: bypass login URL disguise, login lockouts, and global rate
# limiting without changing plugin settings. Set to true only while regaining access,
# then set back to false (or remove the line). Copy to .env in the plugin directory.
# wp-config.php `define('SECUREPRESS_SAFE_MODE', true);` overrides .env when set first.
SECUREPRESS_SAFE_MODE=false

# Audit log database growth (defaults in config/plugin.php; override before large deployments)
SECUREPRESS_AUDIT_RETENTION_DAYS=90
SECUREPRESS_AUDIT_AUTO_PRUNE=true
# PSR-3 level: emergency|alert|critical|error|warning|notice|info|debug
SECUREPRESS_AUDIT_MIN_STORAGE_LEVEL=notice
