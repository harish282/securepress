# PressSentinel environment variables
# Copy to .env and update values as needed.

PRESS_SENTINEL_APP_ENV=production
PRESS_SENTINEL_DEBUG=false

# Default install: ~6 months Pro trial (config/plugin.php `pro_license.beta_trial`).
# Override trial: PRESS_SENTINEL_BETA_TRIAL_ENABLED=false  PRESS_SENTINEL_BETA_TRIAL_DURATION_DAYS=182
# Unlimited Pro without key (optional; overrides trial clock): PRESS_SENTINEL_EARLY_ACCESS=true
# PRESS_SENTINEL_EARLY_ACCESS=

# Offline license HMAC: by default a random secret is stored in the WordPress
# database (`presssentinel_license_hmac_secret`) — no .env required. Override only
# if you must align with external tooling:
# PRESS_SENTINEL_LICENSE_SECRET=
# Or wp-config.php: define('PRESS_SENTINEL_LICENSE_SECRET', '…');
PRESS_SENTINEL_MIN_PHP_VERSION=8.2.0
PRESS_SENTINEL_MIN_WP_VERSION=6.4
PRESS_SENTINEL_LOG_CHANNEL=file
PRESS_SENTINEL_LOG_LEVEL=info
PRESS_SENTINEL_LOG_FILE=presssentinel.log

# Emergency recovery: bypass login URL disguise, login lockouts, and global rate
# limiting without changing plugin settings. Set to true only while regaining access,
# then set back to false (or remove the line). Copy to .env in the plugin directory.
# wp-config.php `define('PRESS_SENTINEL_SAFE_MODE', true);` overrides .env when set first.
PRESS_SENTINEL_SAFE_MODE=false

# Audit log database growth (defaults in config/plugin.php; override before large deployments)
PRESS_SENTINEL_AUDIT_RETENTION_DAYS=90
PRESS_SENTINEL_AUDIT_AUTO_PRUNE=true
# PSR-3 level: emergency|alert|critical|error|warning|notice|info|debug
PRESS_SENTINEL_AUDIT_MIN_STORAGE_LEVEL=notice
